{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "document-windows",
  "description": "Bundled document windows can use explicit document commands, text clipboard, dialogs and their own title/close controls. No filesystem, shell, HTTP or remote webview access.",
  "local": true,
  "windows": ["main", "document-*"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-foundation-health",
    "allow-new-document-window",
    "allow-translate-offline",
    "allow-observe-document-source",
    "allow-observe-document-target",
    "allow-cancel-offline-translation",
    "allow-lookup-dictionary-entries",
    "allow-dictionary-catalog",
    "allow-dictionary-storage-status",
    "allow-preview-dictionary-config",
    "allow-preview-dictionary-import",
    "allow-commit-dictionary-import",
    "allow-reload-dictionary",
    "allow-search-dictionary-entries",
    "allow-save-dictionary-metadata",
    "allow-save-dictionary-entry",
    "allow-delete-dictionary-entry",
    "allow-dictionary-entry-history",
    "allow-export-dictionary",
    "allow-list-shortcuts",
    "allow-preview-shortcuts-import",
    "allow-commit-shortcuts-import",
    "allow-save-shortcut",
    "allow-delete-shortcut",
    "allow-export-shortcuts",
    "allow-repair-dictionary-database",
    "allow-preview-document-import",
    "allow-open-document",
    "allow-save-document",
    "allow-export-document",
    "allow-document-siblings",
    "allow-set-document-title",
    "allow-recovery-list",
    "allow-recovery-read",
    "allow-recovery-release",
    "allow-recovery-write",
    "allow-recovery-discard",
    "allow-load-settings",
    "allow-save-settings",
    "allow-list-ai-profiles",
    "allow-save-ai-profile",
    "allow-delete-ai-profile",
    "allow-set-ai-credential",
    "allow-delete-ai-credential",
    "allow-ai-credential-status",
    "allow-ai-credential-store-status",
    "allow-preview-ai-profile",
    "allow-ai-profile-presets",
    "allow-test-ai-profile",
    "allow-preview-ai-translation",
    "allow-start-ai-translation",
    "allow-cancel-ai-translation",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
